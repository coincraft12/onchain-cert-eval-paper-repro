# 각 변수를 사용자 본인이 발급한 키/엔드포인트로 채운 뒤 이 파일을 .env로 복사해서 쓴다.
# 전부 무료 티어로 충분하다. 이 파일 자체(.env.example)는 플레이스홀더만 담고 있어 커밋해도 안전하지만,
# 실제 키를 채운 .env는 절대 커밋하지 않는다(.gitignore에 이미 포함됨).

# ---- 실험 1 (RPC 재현성) ----
# Polygon mainnet JSON-RPC 엔드포인트. 최소 2개(예: Alchemy + PublicNode)만 있어도 실험 1 본 실행이 가능하다.
# 각 발급처: https://www.alchemy.com (무료 가입) / https://publicnode.com (키 불필요, 공개 엔드포인트)
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PUBLICNODE_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# 선택(3-way 재현 시):
INFURA_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
DRPC_POLYGON_RPC_URL=https://polygon.drpc.org

# run-exp1-chaintip.mjs 전용 — QuickSwap Router 최근 TX·지갑 자체 이력 조회(Etherscan V2 API).
# 발급: https://etherscan.io/apis (무료 가입, Polygon 포함 멀티체인 V2 키 하나로 충분)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_V2_API_KEY

# ---- 실험 4 (로컬 포크) ----
# anvil 실행 시 --fork-url 인자로 직접 넘긴다(.env로 읽지 않음). 예:
#   anvil --fork-url $ALCHEMY_POLYGON_RPC_URL --port 8546 --chain-id 137
# run-exp4-inflation-fork.mjs가 기본으로 바라보는 로컬 anvil RPC 주소(변경 시에만 설정):
# ANVIL_RPC_URL=http://127.0.0.1:8546
